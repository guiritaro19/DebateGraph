# Never commit .env. All providers are independent.
# Copy this file to .env and fill only your local secrets.
# Values below are placeholders or local development defaults.
# Never put a real key in a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Local quickstart. For pgvector use the PostgreSQL URL below.
DATABASE_URL=sqlite:///runtime/debategraph.db
# DATABASE_URL=postgresql+psycopg://debategraph:debategraph@localhost:5433/debategraph
CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_BACKEND=postgres
CHECKPOINT_DATABASE_URL=postgresql://debategraph:debategraph@localhost:5433/debategraph
SEARCH_PROVIDER=openai
SEARCH_MODEL=gpt-4.1-mini
SEARCH_MAX_SOURCES_PER_PHASE=3
# Set SEARCH_PROVIDER=none for local RAG only; Tavily also supported.
SEARCH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
MAX_OUTPUT_TOKENS=2500
MODEL_TIMEOUT_SECONDS=60
